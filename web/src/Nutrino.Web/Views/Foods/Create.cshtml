@model Nutrino.Web.Data.Food
@{
    ViewData["Title"] = "New food";
}

<h1>New food</h1>

<form asp-action="Create" method="post" class="mt-3">
    <partial name="_FoodForm" model="Model" />
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Save food</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
