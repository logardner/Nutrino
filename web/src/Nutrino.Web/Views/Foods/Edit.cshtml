@model Nutrino.Web.Data.Food
@{
    ViewData["Title"] = "Edit food";
}

<h1>Edit @Model.Name</h1>
<p class="text-muted">Changes apply to future logs only. Meals you've already logged keep their original numbers.</p>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="mt-3">
    <partial name="_FoodForm" model="Model" />
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
