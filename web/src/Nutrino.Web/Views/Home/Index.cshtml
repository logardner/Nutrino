@{
    ViewData["Title"] = "Today";
}

<div class="text-center mb-4">
    <h1 class="display-4">Nutrino</h1>
    <p class="text-muted">Today's nutrition (placeholder data)</p>
</div>

<div class="row text-center mb-4">
    <div class="col"><div class="card p-3"><h5>Calories</h5><p class="h3">1,240 / 2,000</p></div></div>
    <div class="col"><div class="card p-3"><h5>Protein</h5><p class="h3">62 / 120 g</p></div></div>
    <div class="col"><div class="card p-3"><h5>Carbs</h5><p class="h3">140 / 220 g</p></div></div>
    <div class="col"><div class="card p-3"><h5>Fat</h5><p class="h3">38 / 65 g</p></div></div>
</div>

<h4>Meals</h4>
<table class="table">
    <thead><tr><th>Meal</th><th>Food</th><th>Calories</th></tr></thead>
    <tbody>
        <tr><td>Breakfast</td><td>Oatmeal with banana</td><td>350</td></tr>
        <tr><td>Lunch</td><td>Chicken salad</td><td>480</td></tr>
        <tr><td>Snack</td><td>Greek yogurt</td><td>130</td></tr>
        <tr><td>Dinner</td><td>(not logged)</td><td>—</td></tr>
    </tbody>
</table>
